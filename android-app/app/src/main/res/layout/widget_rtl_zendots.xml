<?xml version="1.0" encoding="utf-8"?>
<!-- GENERATED (genWidgetLayouts: ltr / rtl x the site's three display fonts) - the home screen widget (NextLaunchWidget)
     in the site's right-to-left direction and its Zen Dots (Mars) mode font: the next launch's photo, a dark fade at the
     bottom, the label, and one row with the launch's name (two lines when it's long - the row grows upward) and the
     time left at its other end. The label and the name twice each: in the mode's font (Latin only, as on the site) and
     in Rubik (Hebrew, Cyrillic, Arabic) - the code shows the one its text needs. The time left as the site's launch
     cards show it: "4d 8h 28m", English letters, left to right in any language, in the mode's font. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/widget_label_latin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/zen_dots"
            android:textColor="#34D399"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_label_other"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rubik_medium"
            android:textColor="#34D399"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/widget_name_latin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/zen_dots"
                    android:maxLines="2"
                    android:textAlignment="viewStart"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/widget_name_other"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/rubik_bold"
                    android:maxLines="2"
                    android:textAlignment="viewStart"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="bottom"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_cd_n1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/zen_dots"
                    android:textColor="#34D399"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/widget_cd_u1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/zen_dots"
                    android:text="d"
                    android:textColor="#A1A1AA"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_cd_n2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/zen_dots"
                    android:textColor="#34D399"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/widget_cd_u2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/zen_dots"
                    android:text="h"
                    android:textColor="#A1A1AA"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_cd_n3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/zen_dots"
                    android:textColor="#34D399"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/widget_cd_u3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:fontFamily="@font/zen_dots"
                    android:text="m"
                    android:textColor="#A1A1AA"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_cd_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/zen_dots"
                    android:textColor="#34D399"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
