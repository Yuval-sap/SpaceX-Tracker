<?xml version="1.0" encoding="utf-8"?>
<!-- the small home screen widget (SmallLaunchWidget) in the site's right-to-left direction: the next launch's photo, dark
     fades at the top and the bottom, the text (a picture drawn in the site's fonts), and in flight the T+ clock at the
     bottom's start - a view of its own, ticking every second. The frame is @android:id/background: the home screen can
     open the app out of the widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_scrim_top" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_scrim" />

    <ImageView
        android:id="@+id/widget_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <Chronometer
        android:id="@+id/widget_tplus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|right"
        android:layout_marginBottom="12dp"
        android:layout_marginRight="12dp"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:letterSpacing="0.04"
        android:textColor="#A1A1AA"
        android:textDirection="ltr"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
