<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="app_background">#09090B</color>
    <color name="app_icon_background">#000000</color>

    <!-- the site's own dark background behind everything, so nothing flashes white while the page loads -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:colorAccent">#10B981</item>
    </style>
</resources>
